{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folklore-atlas.example/schemas/release-manifest-v1.schema.json",
  "title": "Folklore Release Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseId",
    "version",
    "publishedAt",
    "producer",
    "compiler",
    "counts",
    "inputs",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "folklore-release-manifest-v1"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^fa:release:corpus-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "producer": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "compiler": {
      "type": "object",
      "required": ["command", "parser", "node"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "parser": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "input": {
      "type": "object",
      "required": ["path", "sourceUrl", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
